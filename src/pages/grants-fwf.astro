---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Heid Lab — FWF START Prize" scripts={["header.js"]}>
  <main>
    <p class="eyebrow">Austrian Science Fund (FWF) · Since 2024</p>
    <h1>START Prize</h1>
    <p>
      The START Prize is the Austrian Science Fund's most highly endowed award for
      early-career researchers. Awarded to Esther Heid in 2024, it supports the
      group's long-term work on machine learning for sustainable chemistry.
    </p>

    <h2>The project</h2>
    <p><!-- TODO: project title, aims, and a paragraph on what the START funding specifically enables. --></p>

    <h2>Facts</h2>
    <ul class="clean">
      <li>
        <span class="pub-year">Funder</span>
        <strong>Austrian Science Fund (FWF)</strong> — START Prize, awarded 2024.
      </li>
      <li>
        <span class="pub-year">Host institution</span>
        <strong>TU Wien</strong> — Institute of Materials Chemistry.
      </li>
      <li>
        <span class="pub-year">Principal investigator</span>
        <strong><a href={`${base}/pi`}>Esther Heid</a></strong>
      </li>
      <!-- TODO: add FWF project number (e.g. Y-xxx), duration (start/end), and budget. -->
      <!-- TODO: add link to the FWF project database entry. -->
    </ul>

    <h2>People on the project</h2>
    <p>
      START-funded positions in the group are listed on the
      <a href={`${base}/team`}>Team</a> page.
    </p>
    <p><!-- TODO: list the specific START-funded positions and people. --></p>

    <h2>Related publications</h2>
    <p>
      Output from the project appears on the
      <a href={`${base}/publications`}>Publications</a> page.
    </p>
    <p><!-- TODO: filter to the publications that acknowledge this grant. --></p>

    <h2>Acknowledgment</h2>
    <p>
      Supported by the Austrian Science Fund (FWF).
      <!-- TODO: confirm the exact acknowledgment wording and project number required by the FWF, and add the FWF logo. -->
    </p>
  </main>
</Layout>
