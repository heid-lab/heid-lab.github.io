---
import Layout from '../layouts/Layout.astro';
import { pi } from '../data/team';
---
<Layout
  title="Heid Lab — Contact"
  description="How to join or work with the Heid Lab at TU Wien: Ph.D. and postdoc positions, student theses and internships, collaborations, and where to find us."
  active="contact"
>
  <section class="section contact-intro">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How to get in touch</p>
        <h1>Interested in joining?</h1>
        <p>
          We are always glad to hear from people with a background in chemistry,
          computer science, or anything in between. There are three main ways to
          get involved:
        </p>
        <ul class="join-list">
          <li><strong>Ph.D. &amp; postdoc positions</strong>: join the group to
            pursue your own research within our themes.</li>
          <li><strong>Students</strong>: bachelor's or master's thesis projects,
            and shorter research internships.</li>
          <li><strong>Collaborators</strong>: academic or industry partners who
            would like to work with us.</li>
        </ul>
        <p>Tell us what you would like to work on.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={`mailto:${pi.email}`}>Email us<span class="arrow">→</span></a>
        </div>
      </div>

    </div>
  </section>

  <!-- Map + address side by side in an off-white band so they don't stack
       black-on-black with the footer, and read as a distinct block. -->
  <section class="section section--alt contact-map-band">
    <div class="wrap">
      <div class="map-grid">
        <div class="map">
          <iframe
            title="Map showing Getreidemarkt 9, 1060 Vienna"
            src="https://www.google.com/maps?q=Getreidemarkt%209%2C%201060%20Wien%2C%20Austria&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
        <div class="contact-block map-address">
          <h3>Where to find us</h3>
          <p class="big">
            Heid Lab · TU Wien<br />
            Institute of Materials Chemistry<br />
            Getreidemarkt 9<br />
            Building BF<br />
            1060 Vienna<br />
            Austria
          </p>
          <p class="map-note">
            <a class="link-arrow" href="https://www.google.com/maps/search/?api=1&query=Getreidemarkt+9%2C+1060+Wien%2C+Austria">Open in Google Maps <span class="arrow">→</span></a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
