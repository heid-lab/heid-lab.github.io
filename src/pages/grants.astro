---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Heid Lab — Grants" scripts={["header.js"]}>
  <main>
    <p class="eyebrow">Funding</p>
    <h1>Grants</h1>
    <p>
      Our research is supported by competitive grants from the European Research
      Council and the Austrian Science Fund (FWF). Both awards were made in 2024
      and fund the group's long-term work on machine learning for chemical
      reactions.
    </p>

    <div class="grid">
      <article class="card">
        <div class="tags"><span class="tag">European Research Council · 2024</span></div>
        <h3><a href={`${base}/grants-erc`}>ERC Starting Grant</a></h3>
        <p>
          “Deep learning of chemical reactions” — generative and predictive
          deep-learning models for chemical reactions across gas-phase,
          organocatalytic, and biocatalytic systems.
        </p>
        <a class="link-arrow" href={`${base}/grants-erc`}>About this grant <span class="arrow">→</span></a>
      </article>
      <article class="card">
        <div class="tags"><span class="tag">Austrian Science Fund (FWF) · 2024</span></div>
        <h3><a href={`${base}/grants-fwf`}>START Prize</a></h3>
        <p>
          The FWF's most highly endowed award for early-career researchers,
          supporting the group's long-term work on machine learning for
          sustainable chemistry.
        </p>
        <a class="link-arrow" href={`${base}/grants-fwf`}>About this grant <span class="arrow">→</span></a>
      </article>
    </div>

    <h2>At a glance</h2>
    <ul class="clean">
      <li>
        <span class="pub-year">Since 2024</span>
        <strong>ERC Starting Grant</strong> — “Deep learning of chemical
        reactions”, European Research Council.
        <!-- TODO: grant number, duration, project URL. -->
      </li>
      <li>
        <span class="pub-year">Since 2024</span>
        <strong>START Prize</strong> — Austrian Science Fund (FWF).
        <!-- TODO: project number, duration, project URL. -->
      </li>
    </ul>

    <h2>Working with us</h2>
    <p>
      Both grants fund positions in the group. Open positions are listed on the
      <a href={`${base}/team`}>Team</a> page — for informal enquiries, see
      <a href={`${base}/contact`}>Contact</a>.
    </p>
  </main>
</Layout>
