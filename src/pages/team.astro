---
import Layout from '../layouts/Layout.astro';
import IconSprite from '../components/IconSprite.astro';
import TeamCard from '../components/TeamCard.astro';
import { members, groupSections, alumni } from '../data/team';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Heid Lab — Team" active="team" noJs={true} scripts={["header.js", "team.js"]}>
  <IconSprite slot="pre-header" />

  <!-- Full-bleed page hero -->
  <section class="page-hero" style="--hero-zoom: 80vw;">
    <div class="hero-media">
      <img class="hero-edge hero-edge--l" src={`${base}/imgs/group/web/team-hero-wide.jpg?v=2`} alt="" aria-hidden="true" />
      <img class="hero-bg" src={`${base}/imgs/group/web/team-hero-wide.jpg?v=2`} alt="The Heid Lab group at TU Wien" />
      <img class="hero-edge hero-edge--r" src={`${base}/imgs/group/web/team-hero-wide.jpg?v=2`} alt="" aria-hidden="true" />
    </div>
    <div class="hero-content">
      <div class="hero-text">
        <p class="eyebrow">Who we are</p>
        <h1>Meet the group</h1>
        <p class="lead_group">
          We are an interdisciplinary team of computer scientists, chemists, and mathematicians working on machine learning for chemical reactions.
        </p>
      </div>
    </div>
  </section>

  <!-- Principal Investigator -->
  <section class="section">
    <div class="wrap">
      <ul class="roster roster--lead">
        <li id="esther-heid">
          <div class="person-photo">
            <img src={`${base}/imgs/team_members/esther-heid.jpg`} alt="Esther Heid" />
            <p class="photo-credit">Photo: © Ulrich Zinell</p>
          </div>
          <div class="person-body">
            <p class="eyebrow">Principal Investigator</p>
            <h3>Esther Heid</h3>
            <p class="person-role">Assistant Professor · Group Leader</p>
            <p>
              Esther Heid is an Assistant Professor for Machine Learning for
              Sustainable Chemistry in the Faculty of Technical Chemistry, TU Wien,
              Austria, and head of the TU-wide dataTUdiscovery AI/ML service center.
              She received her Ph.D. in Theoretical Chemistry from the University of
              Vienna in 2019. She subsequently held postdoctoral positions at MIT
              (2020–2022) and TU Wien (2022–2024), where she advanced her work at the
              interface of chemistry and machine learning. In 2024, she was awarded a
              prestigious ERC Starting Grant along with an FWF START Prize, and started
              her own research group at TU Wien.
            </p>
            <div class="pi-cta-box">
              <a class="btn btn-outline btn-outline--light" href={`${base}/pi`}>Full profile <span class="arrow">→</span></a>
              <p class="person-links">
                <a href="https://github.com/hesther"><svg class="icon" role="img" aria-label="GitHub"><use href="#i-github"></use></svg></a>
                <a href="https://www.linkedin.com/in/esther-heid-ab20001a6/"><svg class="icon" role="img" aria-label="LinkedIn"><use href="#i-linkedin"></use></svg></a>
                <a href="https://scholar.google.com/citations?user=NDE5issAAAAJ&hl=en"><svg class="icon" role="img" aria-label="Google Scholar"><use href="#i-scholar"></use></svg></a>
              </p>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- The team — masonry profile cards -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Who we are</p>
        <h2>The team</h2>
        <p>Meet our diverse team of postdocs, Ph.D. students, and project students, with backgrounds ranging from theoretical and wet-lab chemistry to computer science and mathematics.</p>
      </div>

      <!-- Filter tabs (JS-enhanced; hidden without JS) -->
      <ul class="team-filter" role="group" aria-label="Filter team members by group">
        <li><button type="button" data-filter="all" aria-pressed="true">All</button></li>
        <li><button type="button" data-filter="postdoc" aria-pressed="false">Postdocs</button></li>
        <li><button type="button" data-filter="phd" aria-pressed="false">Ph.D. Students</button></li>
        <li><button type="button" data-filter="project" aria-pressed="false">Project Students</button></li>
      </ul>

      {groupSections.map((section) => (
        <div class="team-group" data-group={section.group}>
          <h2 id={section.id}>{section.heading}</h2>
          <ul class="team-grid">
            {members
              .filter((m) => m.group === section.group)
              .map((m) => <TeamCard member={m} />)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Alumni -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Alumni</h2>
      </div>
      <!-- Grouped by the year each person left the group (newest first).
           Reuses the .awards / .award-year timeline styling. -->
      <div class="awards">
        {alumni.map((year) => (
          <div class="award-year">
            <div class="ay-num">{year.year}</div>
            <ul>
              {year.people.map((p) => (
                <li><strong>{p.name}</strong>{p.note ? ` — ${p.note}` : ''}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="section section--cta section--alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Join us</p>
        <h2>Looking for a Ph.D. or postdoc position?</h2>
        <p>
          We're always glad to hear from people with a background in chemistry,
          computer science, or anything in between — drop us a line.
        </p>
      </div>
      <a class="btn btn-primary" href={`${base}/contact`}>Get in touch <span class="arrow">→</span></a>
    </div>
  </section>
</Layout>
