---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import TeamCard from '../components/TeamCard.astro';
import { members, groupSections, alumni, pi } from '../data/team';
---
<Layout
  title="Heid Lab — Team"
  description="Meet the Heid Lab at TU Wien: an interdisciplinary team of computer scientists, chemists, and mathematicians working on machine learning for chemical reactions."
  active="team"
  noJs={true}
>
  <!-- Full-bleed page hero -->
  <section class="page-hero" style="--hero-zoom: 90vw; --photo-w: 1600; --photo-h: 1200;">
    <div class="hero-media">
      <img class="hero-edge hero-edge--l" src="/imgs/news/2026-09-zotter.jpg" alt="" aria-hidden="true" />
      <img class="hero-bg" src="/imgs/news/2026-09-zotter.jpg" alt="The Heid Lab group on a summer outing" />
      <img class="hero-edge hero-edge--r" src="/imgs/news/2026-09-zotter.jpg" alt="" aria-hidden="true" />
    </div>
    <div class="hero-content">
      <div class="hero-text">
        <p class="eyebrow">Who we are</p>
        <h1>Meet the group</h1>
        <p class="lead_group">
          We are an interdisciplinary team of computer scientists, chemists, and mathematicians working on machine learning for chemical reactions.
        </p>
      </div>
    </div>
  </section>

  <!-- Principal Investigator -->
  <section class="section">
    <div class="wrap">
      <ul class="roster roster--lead">
        <li id="esther-heid">
          <div class="person-photo">
            <img src={`/imgs/team_members/${pi.photo}`} alt={pi.name} />
            <p class="photo-credit">Photo: © {pi.photoCredit}</p>
          </div>
          <div class="person-body">
            <p class="eyebrow">Principal Investigator</p>
            <h3>{pi.name}</h3>
            <p class="person-role">Assistant Professor · Group Leader</p>
            <p set:html={pi.bio[0]} />
            <div class="pi-cta-box">
              <a class="btn btn-outline btn-outline--light" href="/pi">Full profile <span class="arrow">→</span></a>
              <SocialLinks links={pi.links} />
            </div>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- The team — masonry profile cards -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Who we are</p>
        <h2>The team</h2>
        <p>Meet our diverse team of postdocs, Ph.D. students, and project students, with backgrounds ranging from theoretical and wet-lab chemistry to computer science and mathematics.</p>
      </div>

      <!-- Filter tabs (JS-enhanced; hidden without JS) -->
      <ul class="team-filter" role="group" aria-label="Filter team members by group">
        <li><button type="button" data-filter="all" aria-pressed="true">All</button></li>
        <li><button type="button" data-filter="postdoc" aria-pressed="false">Postdocs</button></li>
        <li><button type="button" data-filter="phd" aria-pressed="false">Ph.D. Students</button></li>
        <li><button type="button" data-filter="project" aria-pressed="false">Project Students</button></li>
      </ul>

      {groupSections.map((section) => (
        <div class="team-group" data-group={section.group}>
          <h2 id={section.id}>{section.heading}</h2>
          <ul class="team-grid">
            {members
              .filter((m) => m.group === section.group)
              .map((m) => <TeamCard member={m} />)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Alumni -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Alumni</h2>
      </div>
      <!-- Grouped by the year each person left the group (newest first).
           Reuses the .awards / .award-year timeline styling. -->
      <div class="awards">
        {alumni.map((year) => (
          <div class="award-year">
            <div class="ay-num">{year.year}</div>
            <ul>
              {year.people.map((p) => (
                <li><strong>{p.name}</strong>{p.note ? ` — ${p.note}` : ''}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="section section--cta section--alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Join us</p>
        <h2>Looking for a Ph.D. or postdoc position?</h2>
        <p>
          We're always glad to hear from people with a background in chemistry,
          computer science, or anything in between — drop us a line.
        </p>
      </div>
      <a class="btn btn-primary" href="/contact">Get in touch <span class="arrow">→</span></a>
    </div>
  </section>
  <script>
    // Group filter tabs. Progressive enhancement — without this script every
    // card is shown and the filter bar is hidden (see the .no-js rule in
    // style.css). We flip <html class="no-js"> to "has-js" here so the filters
    // appear only once JS actually runs.
    const root = document.documentElement;
    root.classList.remove('no-js');
    root.classList.add('has-js');

    const section = document.querySelector('.team-filter');
    if (section) {
      const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>('button[data-filter]'));
      const groups = Array.from(document.querySelectorAll<HTMLElement>('.team-group'));

      // Show a live count next to each tab label.
      buttons.forEach((btn) => {
        const f = btn.dataset.filter;
        const n = f === 'all'
          ? document.querySelectorAll('.team-card').length
          : document.querySelectorAll(`.team-group[data-group="${f}"] .team-card`).length;
        const count = document.createElement('span');
        count.className = 'count';
        count.textContent = String(n);
        btn.append(' ', count);
      });

      const applyFilter = (filter: string) => {
        groups.forEach((group) => {
          group.hidden = !(filter === 'all' || group.dataset.group === filter);
        });
        buttons.forEach((btn) => {
          btn.setAttribute('aria-pressed', String(btn.dataset.filter === filter));
        });
      };

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => applyFilter(btn.dataset.filter ?? 'all'));
      });
    }
  </script>
</Layout>
