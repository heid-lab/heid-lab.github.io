---
import Layout from '../layouts/Layout.astro';
import NewsList from '../components/NewsList.astro';
import NewsGallery from '../components/NewsGallery.astro';
---
<Layout
  title="Heid Lab — News"
  description="News from the Heid Lab at TU Wien: awards and prizes, new arrivals, thesis defenses, and other group milestones."
  active="news"
>
  <div class="page">
    <p class="eyebrow">What's new</p>
    <h1>The latest from the lab</h1>
    <p>
      Awards & prizes, new arrivals, and group milestones.
    </p>

    <NewsList months collapse={5} />

    <NewsGallery />
  </div>
</Layout>
