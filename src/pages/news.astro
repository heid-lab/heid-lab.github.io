---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Heid Lab — News"
  active="news"
  scripts={["news-data.js", "news.js", "news-gallery.js", "header.js"]}
>
  <main>
    <p class="eyebrow">What's New</p>
    <h1>The latest from the lab</h1>
    <p>
      Awards, new arrivals, and group milestones — newest first.
    </p>

    <div data-news data-news-months data-news-collapse="5"></div>

    <section class="gallery">
      <h2 class="gallery-heading">Life in the lab</h2>
      <div class="gallery-viewport" data-news-gallery></div>
    </section>
  </main>
</Layout>
