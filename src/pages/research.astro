---
import Layout from '../layouts/Layout.astro';
import { funding } from '../data/funding';
---
<Layout
  title="Heid Lab — Research"
  description="Research at the Heid Lab, TU Wien: machine learning for reaction property prediction, transition state generation, automated transition state search, and reaction data."
  active="research"
>
  <!-- Intro -->
  <section class="section section--intro">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we work on</p>
        <h1>Research</h1>
        <p>
          We develop machine learning methods to understand and predict
          chemical reactions. Our work spans the full pipeline from
          data generation and curation to model development and benchmarking,
          bridging data-driven AI and mechanistic chemistry.
        </p>
      </div>

      <!-- Signpost — links that scroll down to each part of the page. The rule
           above them anchors it as a finished element rather than labels
           floating in the intro's white space. -->
      <nav class="parts" aria-label="On this page">
        <a class="part" href="#vision"><span class="part-arrow" aria-hidden="true">→</span>Our vision</a>
        <a class="part" href="#areas"><span class="part-arrow" aria-hidden="true">→</span>Areas of research</a>
        <a class="part" href="#funding"><span class="part-arrow" aria-hidden="true">→</span>Funding</a>
      </nav>
    </div>
  </section>

  <!-- Vision — a dark, full-bleed banner that sets the group's guiding
       perspective apart, as a header ahead of the research threads below.
       Anchored to the group's perspective paper via the Read more panel. -->
  <section class="band vision-band" id="vision">
    <div class="wrap">
      <div class="vision">
        <p class="eyebrow">Our vision</p>
        <p class="statement">
          Machine learning for chemical reactions has the potential to enable
          high-throughput screening at a scale previously out of reach,
          accelerating discovery in drug synthesis, materials design, and sustainable chemistry.
        </p>

        <details class="vision-more">
          <summary>
            <span class="label label-more">Read more</span>
            <span class="label label-less">Show less</span>
            <span class="chev" aria-hidden="true">▾</span>
          </summary>
          <div class="vision-more-body">
            <p>The <strong>current challenges</strong> in the field span representation, model architecture, and data:</p>
            <ul>
              <li>Quantum mechanical calculations are too expensive for large-scale screening.</li>
              <li>Encoding the full chemical transformation, not just reactants and products, remains an open problem.</li>
              <li>Available datasets are small and lack mechanistic diversity.</li>
              <li>Existing ML models are largely adapted from molecular property prediction, lacking reaction-specific inductive biases.</li>
            </ul>
            <p>
              We believe ML models should be built around chemical principles from the
              ground up: starting with meaningfully curated datasets, moving to
              chemically informed representations, and reaction-specific
              architectures. Together, these lay the foundation for direct, reliable
              prediction of reaction energetics at the scale real applications demand.
            </p>
          </div>
          <a class="btn btn-outline" href="https://doi.org/10.1063/5.0321836">Read our perspective paper <span class="arrow">→</span></a>
        </details>
      </div>
    </div>
  </section>

  <!-- Areas of research — header introducing the four threads below. -->
  <section class="section section--lead" id="areas">
    <div class="wrap">
      <p class="eyebrow">Areas of research</p>
      <p class="prose">
        Working toward this goal, we tackle every step along the way: from the
        models themselves, through the automated pipelines that put them to work,
        to the data everything depends on.
      </p>

      <!-- Tabs — one per theme below. JS shows one panel at a time (01 by
           default); without JS the links still jump to the full stacked panels. -->
      <div class="area-cards" role="tablist" aria-label="Areas of research">
        <a class="area-card" id="tab-01" role="tab" aria-controls="area-01" href="#area-01">
          <span class="area-card-num">01</span>
          <span class="area-card-title">Prediction</span>
        </a>
        <a class="area-card" id="tab-02" role="tab" aria-controls="area-02" href="#area-02">
          <span class="area-card-num">02</span>
          <span class="area-card-title">TS Generation</span>
        </a>
        <a class="area-card" id="tab-03" role="tab" aria-controls="area-03" href="#area-03">
          <span class="area-card-num">03</span>
          <span class="area-card-title">Automation</span>
        </a>
        <a class="area-card" id="tab-04" role="tab" aria-controls="area-04" href="#area-04">
          <span class="area-card-num">04</span>
          <span class="area-card-title">Data</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 01 · Property prediction -->
  <section class="section theme" id="area-01" role="tabpanel" aria-labelledby="tab-01">
    <div class="wrap theme-cols theme-cols--media-right">
      <aside class="theme-aside">
        <figure class="theme-media">
          <img src="/imgs/research/01-chem-prop-pred.png" alt="ChemTorch: a modular, multi-modal framework for accelerating deep learning of chemical reactions." loading="lazy" />
        </figure>
      </aside>
      <div class="theme-text">
        <p class="eyebrow"><span class="theme-num">01</span> Prediction</p>
        <h2>Chemical reaction property prediction</h2>
        <p>
          Predicting properties of chemical reactions, such as barrier heights or
          reaction enthalpies, is a key task in computational chemistry.
          Machine learning offers a powerful framework for approximating
          reaction properties, without the cost of exhaustive quantum mechanical
          calculations. As a foundation for community-driven method development
          and reproducible benchmarking, we developed
          <a href="https://doi.org/10.1021/acs.jcim.5c02645" target="_blank" rel="noopener noreferrer" class="paper-link" data-paper="chemtorch">ChemTorch</a>,
          an open-source deep learning framework that
          streamlines model development and benchmarking across different
          modalities for chemical reaction property prediction.
        </p>
        <p>
          A particular focus of our work lies in the <a href="https://doi.org/10.1039/D5DD00240K" target="_blank" rel="noopener noreferrer" class="paper-link" data-paper="barriers">prediction of reaction
          barrier heights</a>, which govern reaction rates and selectivity and
          are notoriously expensive to obtain via traditional QM
          methods. We have shown that graph neural networks operating on the condensed graph of reaction (CGR)
          provide high predictive accuracy, and that further incorporating
          transition state geometries significantly improves
          barrier height predictions over purely connectivity-based approaches.
        </p>

        <p>
          Beyond graph-based methods, we also investigate language model approaches
          for reaction property prediction. We introduced <a href="https://doi.org/10.1039/D6DD00120C" target="_blank" rel="noopener noreferrer" class="paper-link" data-paper="sr-smiles">sr-SMILES</a>, a compact
          sequence-based representation derived from the CGR that encodes explicit
          mechanistic and stereochemical information in a textual format amenable to
          transformer models.
        </p>
        <div class="theme-papers">
          <span class="label">Related work</span>
          <ul>
            <li data-paper="chemtorch"><a href="https://doi.org/10.1021/acs.jcim.5c02645">ChemTorch: A Deep Learning Framework for Benchmarking and Developing Chemical Reaction Property Prediction Models</a> · J. Chem. Inf. Model. 2026</li>
            <li data-paper="barriers"><a href="https://doi.org/10.1039/D5DD00240K">Graph-based prediction of reaction barrier heights with on-the-fly prediction of transition states</a> · Digital Discovery 2025</li>
            <li data-paper="sr-smiles"><a href="https://doi.org/10.1039/D6DD00120C">Bridging CGR representations and language models for reaction property prediction</a> · Digital Discovery 2026</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 · Generative TS models -->
  <section class="section theme" id="area-02" role="tabpanel" aria-labelledby="tab-02">
    <div class="wrap theme-cols theme-cols--media-left">
      <aside class="theme-aside">
        <figure class="theme-media">
          <img src="/imgs/research/02-ts-goflow.jpeg" alt="GoFlow: flow matching that transforms random noise into a transition-state structure." loading="lazy" />
        </figure>
      </aside>
      <div class="theme-text">
        <p class="eyebrow"><span class="theme-num">02</span> Generative models</p>
        <h2>Generative modeling for transition states</h2>
        <p>
          Generative models have emerged as a promising approach for transition state
          (TS) geometry generation. Our method
          <a href="https://doi.org/10.1039/D5DD00283D" target="_blank" rel="noopener noreferrer" class="paper-link" data-paper="goflow">GoFlow</a>
          frames TS generation as an optimal transport flow problem, solved via
          E(3)-equivariant flow matching with geometric tensor networks. Compared
          to prior diffusion-based approaches, GoFlow achieves a significant
          speedup in inference while improving geometric accuracy,
          enabling deep learning-based TS generation for high-throughput computational chemistry workflows.
        </p>
        <p>
          While models like GoFlow generate TS geometries with high accuracy,
          they lack chirality awareness. We address this with
          <a href="https://doi.org/10.48550/arXiv.2509.01543" target="_blank" rel="noopener noreferrer" class="paper-link" data-paper="fkflow">Feynman-Kac-Flow</a>,
          which derives Feynman-Kac steering for conditional
          flow matching. By tilting the generated distribution with an energy
          potential, our approach steers samples toward chirality-consistent
          transition states, marking an important step toward chirality-aware TS generation.
        </p>
        <p>
          Beyond chemical reactions, the GoFlow framework generalizes to other
          geometry prediction tasks, such as minimum-energy triplet geometries. <a href="https://chemrxiv.org/doi/full/10.26434/chemrxiv.15003682/v1" target="_blank" rel="noopener noreferrer" class="paper-link" data-paper="goflow-t1">GoFlow-T1</a>
          adapts the same backbone to predict these excited-state geometries
          directly across chemically diverse organic molecules,
          enabling rapid computation of triplet energies and singlet-triplet gaps
          at near-quantum-mechanical accuracy.
        </p>
        <div class="theme-papers">
          <span class="label">Related work</span>
          <ul>
            <li data-paper="goflow"><a href="https://doi.org/10.1039/D5DD00283D">GoFlow: efficient transition state geometry prediction with flow matching and E(3)-equivariant neural networks</a> · Digital Discovery 2025</li>
            <li data-paper="fkflow"><a href="https://doi.org/10.48550/arXiv.2509.01543">Feynman-Kac-Flow: Inference Steering of Conditional Flow Matching to an Energy-Tilted Posterior</a> · arXiv 2025 (Preprint)</li>
            <li data-paper="goflow-t1"><a href="https://chemrxiv.org/doi/full/10.26434/chemrxiv.15003682/v1">Prediction of triplet geometries across chemical space with flow-matching based machine learning</a> · ChemRxiv 2026 (Preprint)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · Automated workflows -->
  <section class="section theme" id="area-03" role="tabpanel" aria-labelledby="tab-03">
    <div class="wrap theme-cols theme-cols--media-right">
      <aside class="theme-aside theme-aside--wide">
        <figure class="theme-media">
          <img src="/imgs/research/03-motsart.png" alt="moTSart: an automated transition state search pipeline that goes from a SMILES input through a reactant complex finder, a reaction path guesser, and a validator to TS conformers, with GoFlow delta learning improving the TS guesses." loading="lazy" />
        </figure>
      </aside>
      <div class="theme-text">
        <p class="eyebrow"><span class="theme-num">03</span> Automated workflows</p>
        <h2>ML-accelerated automated transition state search</h2>
        <p>
        Generating accurate TS geometries is only one part of the challenge;
        integrating them into robust, scalable workflows for reaction mechanism
        exploration is another. Standalone deep learning predictors lack
        robustness under distribution shift, while heuristic-based automation
        struggles to scale, limiting their utility for high-throughput discovery.
      </p>
      <p>
        With <a href="https://doi.org/10.1039/D6DD00259E" target="_blank" rel="noopener noreferrer" class="paper-link" data-paper="motsart">moTSart</a>
        we address this by embedding a generative model directly within a
        fully automated TS search pipeline, coupled with physics-based
        validation. Rather than replacing quantum mechanics, the model
        accelerates it by proposing high-quality geometry candidates that
        reduce the number of costly optimization cycles required. The
        framework operates in a continuous learning regime, improving as
        more reactions are processed: in a high-throughput screening study
        of bio-orthogonal click reactions, the required TS optimization
        cycles dropped by nearly 50% after processing just 540 reactions.
      </p>
        <div class="theme-papers">
          <span class="label">Related work</span>
          <ul>
            <li data-paper="motsart"><a href="https://doi.org/10.1039/D6DD00259E">moTSart: accelerating automated transition state search with generative models in a low-data regime</a> · Digital Discovery 2026</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · Data creation & analysis -->
  <section class="section theme" id="area-04" role="tabpanel" aria-labelledby="tab-04">
    <div class="wrap theme-cols">
      <div class="theme-text">
        <p class="eyebrow"><span class="theme-num">04</span> Data</p>
        <h2>Curating and generating reaction data</h2>
        <p>
          While ML models and representations for chemical reactions have matured
          rapidly, data is a real bottleneck. Existing datasets tend to be small,
          restricted to gas-phase reactions, and often mechanistically incomplete.
          We believe that progress depends on generating the right data:
          mechanistically diverse, internally consistent, and grounded in chemically
          meaningful elementary steps.
        </p>
        <div class="theme-split">
          <div>
            <span class="label">Computational</span>
            <p>
              We develop principled strategies for data curation and generation —
              prioritizing chemical diversity, consistent levels of theory, and
              validated transition states over sheer dataset size.
            </p>
          </div>
          <div>
            <span class="label">Experimental</span>
            <p>
              We work in the wet lab to generate reaction data ourselves. A current
              focus is asymmetric organocatalysis, where enantioselectivity serves
              as a direct and measurable experimental observable, and reaction
              spaces grow combinatorially, making data-driven, intelligent sampling
              of the reaction space essential.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Funding — grouped with the open-source CTA as the page's closing "about
       the lab" blocks. The ERC grant leads, as it funds much of this work; the
       other funders follow beneath it, listed from src/data/funding.ts. -->
  <section class="section section--funding" id="funding">
    <div class="wrap">
      <div class="erc-callout">
        <div class="erc-callout-text">
          <p class="eyebrow">Funding</p>
          <h2>Made possible by competitive research funding</h2>
          <p>
            A big part of our research is supported by a €1.5M ERC Starting Grant,
            awarded to Esther Heid in 2024 to develop data-driven deep-learning
            frameworks for organic and enzymatic reactions.
          </p>
          <a class="link-arrow" href="/grants-erc">Explore the ERC project <span class="arrow">→</span></a>
        </div>
        <span class="erc-callout-logo">
          <img src="/imgs/grants/erc-eu-logo.png" alt="Funded by the European Union — European Research Council" />
        </span>
      </div>
      <div class="funding-more">
        <p class="funding-more-intro">We are further supported by the following grants and programs:</p>
        <ul class="funding-tiles">
          {funding.map((f, i) => {
            const external = f.href?.startsWith('http');
            return (
              <li class="funding-tile">
                <button class="funding-tile-face" type="button" aria-expanded="false" aria-controls={`funding-details-${i}`}>
                  <span class="funding-mark">
                    {f.logo
                      ? [f.logo].flat().map((logo, j) => <img class:list={['funding-logo', { 'funding-logo--wordmark': f.wordmark }]} src={`/imgs/${logo}`} alt={j === 0 ? (f.logoAlt ?? f.funder) : ''} />)
                      : <span class="funding-mark-text">{f.short ?? f.funder}</span>}
                  </span>
                  <span class="funding-name">{f.name}</span>
                  <span class="funding-tile-plus" aria-hidden="true"></span>
                </button>
                <div class="funding-tile-details" id={`funding-details-${i}`}>
                  {f.amount && <span class="funding-amount">{f.amount}</span>}
                  {f.period && <span class="funding-period">{f.period}</span>}
                  {f.href && (
                    <a class="link-arrow funding-link" href={f.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
                      Learn more <span class="arrow">→</span>
                    </a>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>

  <!-- Open-source commitment — a light closing CTA. Kept light (not the dark
       .band treatment) so it reads distinctly from the dark footer directly
       below it, rather than bleeding into it. Set as a boxed card so it doesn't
       repeat the eyebrow + heading layout of the ERC callout above. -->
  <section class="opensource">
    <div class="wrap">
      <div class="opensource-card">
        <div class="opensource-text">
          <p class="eyebrow">Open source</p>
          <h2>Committed to open, reproducible research</h2>
          <p>
            We hold our work to a high scientific standard and share it openly.
            Our models, code, and datasets are released as open source, so the
            community can reproduce our results and build on them.
          </p>
        </div>
        <a class="btn btn-outline" href="https://github.com/heid-lab" target="_blank" rel="noopener">
          <svg class="gh-icon" aria-hidden="true" width="18" height="18" fill="currentColor"><use href="#i-github"></use></svg>
          View our code on GitHub <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>
  <script>
    // "Areas of research" tabs. Progressive enhancement: the tablist and the
    // four .theme panels render stacked without JS (and the tab links still jump
    // to each panel). With JS, the tabs show one panel at a time — 01 by default.
    const list = document.querySelector('.area-cards[role="tablist"]');
    const tabs = list ? Array.from(list.querySelectorAll<HTMLElement>('[role="tab"]')) : [];
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls') ?? ''));

    if (tabs.length >= 2 && panels.every((p) => p)) {
      // Signals to the stylesheet that tabs are active (enables the tab-folder
      // look and the single-panel layout). Only set once we know enhancement
      // will run.
      document.documentElement.classList.add('js-tabs');

      const select = (index: number, focusTab = false) => {
        tabs.forEach((tab, i) => {
          const on = i === index;
          tab.setAttribute('aria-selected', String(on));
          tab.classList.toggle('is-active', on);
          tab.tabIndex = on ? 0 : -1;
          panels[i]!.hidden = !on;
        });
        if (focusTab) tabs[index].focus();
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', (e) => {
          e.preventDefault();
          select(i);
          // Record the tab in the URL so leaving the page and coming back (or
          // sharing the link) restores this tab instead of falling back to 01.
          history.replaceState(null, '', '#' + tab.getAttribute('aria-controls'));
        });
        tab.addEventListener('keydown', (e) => {
          let next: number;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % tabs.length;
          else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = tabs.length - 1;
          else return;
          e.preventDefault();
          select(next, true);
        });
      });

      // If the page was opened with a #area-0x hash, honor it; otherwise show 01.
      const indexForHash = () => {
        const hash = location.hash.replace('#', '');
        return Math.max(0, tabs.findIndex((tab) => tab.getAttribute('aria-controls') === hash));
      };

      select(indexForHash());

      // Back/forward navigation only changes the hash — resync the visible panel.
      window.addEventListener('hashchange', () => select(indexForHash()));
    }
  </script>

  <script>
    // Funding tiles. Each tile shows a funder's logo and grant name; its details
    // (funder, period, amount, link) appear on hover via CSS on devices that can
    // hover, and a click or tap pins them open here. One tile is pinned at a
    // time; a click elsewhere, Escape, or following a tile's link closes it, and
    // tiles reset when the visitor returns to the page. Without JS, hover still
    // works and the details stay reachable by keyboard (see .funding-tile in
    // style.css).
    const tiles = Array.from(document.querySelectorAll<HTMLElement>('.funding-tile'));

    const setOpen = (tile: HTMLElement, open: boolean) => {
      tile.classList.toggle('is-open', open);
      tile.querySelector('.funding-tile-face')?.setAttribute('aria-expanded', String(open));
    };
    const closeAll = () => tiles.forEach((t) => setOpen(t, false));

    if (tiles.length) {
      tiles.forEach((tile) => {
        tile.addEventListener('click', (e) => {
          // Links inside the open details navigate as usual; the tile un-pins so
          // it isn't still open when the visitor comes back.
          if ((e.target as Element).closest('a')) { closeAll(); return; }
          const open = !tile.classList.contains('is-open');
          closeAll();
          setOpen(tile, open);
        });
      });

      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.funding-tile')) closeAll();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAll();
      });
      // Back/forward navigation can restore the page as it was left (bfcache).
      window.addEventListener('pageshow', closeAll);
    }
  </script>
</Layout>
