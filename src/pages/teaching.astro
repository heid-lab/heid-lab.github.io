---
import Layout from '../layouts/Layout.astro';

// Courses taught this semester, each drawn as a card linking to TISS. A course
// with its own page on this site sets `page` (its path under src/pages, e.g.
// 'teaching/deep-learning-in-chemistry'), and its card links there as well.
// New course pages start as a copy of src/pages/teaching/_course-template.astro.
// `semester` is the TISS code (2026W = winter 2026/27, 2027S = summer 2027);
// the heading and intro sentence above the cards follow it.
const semester = '2026W';
const currentCourses: { nr: string; type: string; ects: string; title: string; page?: string }[] = [
  { nr: '165.169', type: 'SE', ects: '3.0', title: 'Interdisciplinary Foundations of Deep Learning in Chemistry' },
  { nr: '165.144', type: 'VU', ects: '3.0', title: 'Simulation of condensed matter' },
  { nr: '164.385', type: 'VU', ects: '4.0', title: 'Programming for Chemistry and PE' },
  { nr: '165.164', type: 'PR', ects: '3.0', title: 'Selected Topics in Theoretical Chemistry' },
  { nr: '360.239', type: 'VO', ects: '2.0', title: 'Introduction to Computational Science and Engineering' },
  { nr: '193.026', type: 'VU', ects: '6.0', title: 'Methods for Data Generation and Analytics in Medicine and Life Sciences' },
];
const tissUrl = (nr: string, sem = semester) =>
  `https://www.tiss.tuwien.ac.at/course/courseDetails.xhtml?semester=${sem}&locale=en&courseNr=${nr.replace('.', '')}`;

// Past courses, newest semester first. Semester codes follow TISS: 2026S is
// summer 2026, 2025W is winter 2025/26. `nr` and `type` (VU, VO, SE, PR, UE,
// LU, …) are the TISS course number and type, checked against the TISS course
// API for that semester. Each name links to its TISS page for that semester.
// The table groups rows by semester.
const pastCourses = [
  { sem: '2026S', nr: '165.171', type: 'VU', title: 'AI in Chemistry' },
  { sem: '2026S', nr: '165.169', type: 'SE', title: 'Interdisciplinary Foundations of Deep Learning in Chemistry' },
  { sem: '2026S', nr: '194.147', type: 'PR', title: 'Interdisciplinary Project in Data Science' },
  { sem: '2026S', nr: '360.243', type: 'VU', title: 'Numerical Simulation and Scientific Computing II' },
  { sem: '2026S', nr: '165.164', type: 'PR', title: 'Selected Topics in Theoretical Chemistry' },
  { sem: '2025W', nr: '165.169', type: 'SE', title: 'Interdisciplinary Foundations of Deep Learning in Chemistry' },
  { sem: '2025W', nr: '360.239', type: 'VO', title: 'Introduction to Computational Science and Engineering' },
  { sem: '2025W', nr: '193.026', type: 'VU', title: 'Methods for Data Generation and Analytics in Medicine and Life Sciences' },
  { sem: '2025W', nr: '164.385', type: 'VU', title: 'Programming for Chemistry and PE' },
  { sem: '2025W', nr: '165.164', type: 'PR', title: 'Selected Topics in Theoretical Chemistry' },
  { sem: '2025W', nr: '165.144', type: 'VU', title: 'Simulation of condensed matter' },
  { sem: '2025S', nr: '360.243', type: 'VU', title: 'Numerical Simulation and Scientific Computing II' },
  { sem: '2025S', nr: '164.373', type: 'VU', title: 'Programming for Chemists' },
  { sem: '2024W', nr: '360.239', type: 'VO', title: 'Introduction to Computational Science and Engineering' },
  { sem: '2024W', nr: '165.166', type: 'VU', title: 'Introduction to Theoretical Chemistry' },
  { sem: '2024W', nr: '165.144', type: 'VU', title: 'Simulation of condensed matter' },
  { sem: '2024S', nr: '360.243', type: 'VU', title: 'Numerical Simulation and Scientific Computing II' },
  { sem: '2024S', nr: '164.373', type: 'VU', title: 'Programming for Chemists' },
  { sem: '2023W', nr: '360.239', type: 'VO', title: 'Introduction to Computational Science and Engineering' },
  { sem: '2023W', nr: '165.166', type: 'VU', title: 'Introduction to Theoretical Chemistry' },
  { sem: '2023W', nr: '165.144', type: 'VU', title: 'Simulation of condensed matter' },
];
const pastSemesters = [...new Set(pastCourses.map((c) => c.sem))].map((sem) => ({
  sem,
  courses: pastCourses.filter((c) => c.sem === sem),
}));
const semesterLabel = (sem: string) => {
  const year = Number(sem.slice(0, 4));
  return sem.endsWith('W') ? `Winter ${year}/${String(year + 1).slice(2)}` : `Summer ${year}`;
};
---
<Layout
  title="Heid Lab — Teaching"
  description="Courses taught by the Heid Lab at TU Wien, past and present, and how to do a thesis, project, or internship with us."
  active="teaching"
>
  <div class="page">
    <p class="eyebrow">Courses & theses</p>
    <h1>Teaching</h1>
    <p>Courses offered by the lab and opportunities for students.</p>

    <section class="current-courses">
      <div class="current-courses-head">
        <h2>Current courses · {semesterLabel(semester)}</h2>
        <p>During the {semester.endsWith('W') ? 'winter' : 'summer'} semester we teach the following courses:</p>
      </div>
      <div class="course-cards">
        {currentCourses.map((c) => c.page ? (
          <div class="course-card">
            <span class="course-meta">{c.nr} · {c.type} · {c.ects} ECTS</span>
            <h3>{c.title}</h3>
            <span class="course-links">
              <a class="course-link" href={`/${c.page}`}>Course details <span aria-hidden="true">→</span></a>
              <a class="course-link" href={tissUrl(c.nr)} target="_blank" rel="noopener">View on TISS <span aria-hidden="true">→</span></a>
            </span>
          </div>
        ) : (
          <a class="course-card" href={tissUrl(c.nr)} target="_blank" rel="noopener">
            <span class="course-meta">{c.nr} · {c.type} · {c.ects} ECTS</span>
            <h3>{c.title}</h3>
            <span class="course-link">View on TISS <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>

    <h2>Past courses</h2>
    <p>Courses previously taught by members of the lab.</p>
    <div class="table-scroll">
      <table class="course-table">
        <thead>
          <tr>
            <th scope="col">Semester</th>
            <th scope="col" class="course-nr">Course no.</th>
            <th scope="col">Course name</th>
          </tr>
        </thead>
        {pastSemesters.map((s) => (
          <tbody>
            {s.courses.map((c, i) => (
              <tr>
                {i === 0 && (
                  <th scope="rowgroup" rowspan={s.courses.length} class="course-sem">
                    {semesterLabel(s.sem)}
                    <span class="course-sem-code">{s.sem}</span>
                  </th>
                )}
                <td class="course-nr">{c.nr}</td>
                <td>
                  <span class="course-type">{c.type}</span><a class="course-name" href={tissUrl(c.nr, c.sem)} target="_blank" rel="noopener">{c.title}<span class="course-go" aria-hidden="true">→</span></a>
                </td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>

    <h2>Looking for a thesis?</h2>
    <p>
      We are always interested in motivated students. If you would like to do a
      thesis, project, or internship with us, please get in touch via the
      <a href="/contact">contact page</a>.
    </p>
  </div>
</Layout>
