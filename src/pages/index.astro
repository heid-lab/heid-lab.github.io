---
import Layout from '../layouts/Layout.astro';
import NewsList from '../components/NewsList.astro';
const hero = '/imgs/hero/esther-heid-hero.jpg';
---
<Layout
  title="Heid Lab — Welcome"
  description="The Heid Lab at TU Wien develops deep learning methods for chemical reactions, bridging AI and mechanistic chemistry to enable high-throughput reaction screening."
  active="home"
>
  <!-- Full-bleed cover hero -->
  <section class="hero-cover">
    <div class="hero-media">
      <img class="hero-edge hero-edge--l" src={hero} alt="" aria-hidden="true" />
      <img class="hero-bg" src={hero} alt="Esther Heid at TU Wien" />
      <img class="hero-edge hero-edge--r" src={hero} alt="" aria-hidden="true" />
    </div>
    <p class="hero-credit">Photo: © Ulrich Zinell</p>
    <div class="hero-content">
      <p class="eyebrow">Heid Lab · TU Wien · Institute of Materials Chemistry</p>
      <h1>Deep learning for chemical reactions</h1>
      <p class="lead">
        Bridging AI and mechanistic chemistry to enable high-throughput screening of chemical reactions.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/research">View research <span class="arrow">→</span></a>
        <a class="btn btn-outline" href="/team" style="color:#fff;">Meet the team <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- About / split -->
  <section class="section">
    <div class="wrap split">
      <div class="split-media">
        <div class="slideshow" aria-label="Photos of the Heid Lab group" aria-roledescription="carousel">
          <div class="slideshow-track">
            <img class="is-active" src="/imgs/group/web/sel-5.jpg" alt="The Heid Lab group" />
            <img src="/imgs/group/web/sel-1.jpg" alt="" />
            <img src="/imgs/group/web/sel-2.jpg" alt="" />
            <img src="/imgs/group/web/sel-3.jpg" alt="" />
            <img src="/imgs/group/web/sel-4.jpg" alt="" />
            <img src="/imgs/group/web/sel-6.jpg" alt="" />
          </div>
          <button class="slideshow-arrow slideshow-arrow--prev" type="button" aria-label="Previous photo">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 L7 12 L15 20" /></svg>
          </button>
          <button class="slideshow-arrow slideshow-arrow--next" type="button" aria-label="Next photo">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4 L17 12 L9 20" /></svg>
          </button>
          <div class="slideshow-dots"></div>
        </div>
      </div>
      <div class="split-body">
        <p class="eyebrow">What we do</p>
        <h2>Accelerating chemical discovery with AI</h2>
        <p>
          The Heid Lab is led by Esther Heid, Assistant Professor for Machine
          Learning for Sustainable Chemistry at TU Wien. We develop machine learning
          methods to predict and model chemical reactions, ranging from barrier heights
          and reaction energies to transition state geometries. Our work combines
          graph neural networks, generative models, and quantum chemistry.
        </p>
        <p>
          Our research spans reaction property prediction, transition state modeling,
          and ML-accelerated automated reaction pathway search across gas-phase, organocatalytic,
          and biocatalytic reactions.
        </p>
        <a class="link-arrow" href="/research">Explore our work <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- Funding / grants band -->
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Projects</p>
      <h2>Funded by the ERC and FWF</h2>
      <div class="funding-intro">
        <div class="funding-intro-text">
          <p>
            Our work is supported by multiple grants including a highly competitive ERC Starting Grant
            and an FWF START Prize, supporting the group's long-term research on machine learning
            for chemical reactions as part of the <strong>DeepRxn</strong> project.
          </p>
        </div>
        <span class="funding-badge funding-badge--deeprxn">
          <img src="/imgs/grants/deeprxn-logo.png" alt="DeepRxn — Deep learning of chemical reactions" />
        </span>
      </div>

      <div class="grant-cards">
        <article class="grant-card">
          <span class="funding-badge funding-badge--erc">
            <img src="/imgs/grants/erc-eu-logo.png" alt="Funded by the European Union — European Research Council" />
          </span>
          <p class="grant-meta">European Research Council · 2024 · €1.5M</p>
          <h3>ERC Starting Grant</h3>
          <div class="grant-links">
            <a class="link-arrow" href="/grants-erc">Explore the research <span class="arrow">→</span></a>
            <a class="link-arrow link-arrow--secondary" href="https://cordis.europa.eu/project/id/101162908/en" target="_blank" rel="noopener">Project description <span class="arrow">→</span></a>
          </div>
        </article>
        <article class="grant-card">
          <span class="funding-badge">
            <img src="/imgs/grants/fwf-logo.png" alt="Austrian Science Fund (FWF)" />
          </span>
          <p class="grant-meta">Austrian Science Fund (FWF) · 2024 · €200K</p>
          <h3>FWF START Prize</h3>
          <div class="grant-links">
            <a class="link-arrow" href="https://www.fwf.ac.at/en/research-radar/10.55776/STA192" target="_blank" rel="noopener">Project description <span class="arrow">→</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- News timeline — items live in src/data/news.ts -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we've been up to</p>
        <h2>News</h2>
      </div>
      <NewsList limit={3} />
      <div class="btn-row">
        <a class="link-arrow" href="/news">All news <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- Featured research -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2>Featured research</h2>
        <p>Here's a selection of recent highlights.</p>
      </div>
      <div class="grid">
        <article class="card">
          <div class="tags"><span class="tag">Digital Discovery · 2025</span></div>
          <h3><a href="https://doi.org/10.1039/D5DD00283D">GoFlow: transition-state geometry prediction with flow matching and E(3)-equivariant networks</a></h3>
          <p>L. Galustian, K. Mark, J. Karwounopoulos, M. P.-P. Kovar, E. Heid</p>
          <a class="link-arrow" href="https://doi.org/10.1039/D5DD00283D">Read paper <span class="arrow">→</span></a>
        </article>
        <article class="card">
          <div class="tags"><span class="tag">Digital Discovery · 2025</span></div>
          <h3><a href="https://doi.org/10.1039/D5DD00240K">Graph-based prediction of reaction barrier heights with on-the-fly transition states</a></h3>
          <p>J. Karwounopoulos, J. De Landsheere, L. Galustian, T. Jechtl, E. Heid</p>
          <a class="link-arrow" href="https://doi.org/10.1039/D5DD00240K">Read paper <span class="arrow">→</span></a>
        </article>
        <article class="card">
          <div class="tags"><span class="tag">J. Chem. Inf. Model. · 2026</span></div>
          <h3><a href="https://doi.org/10.1021/acs.jcim.5c02645">ChemTorch: a deep learning framework for reaction property prediction</a></h3>
          <p>J. De Landsheere, A. Zamyatin, J. Karwounopoulos, E. Heid</p>
          <a class="link-arrow" href="https://doi.org/10.1021/acs.jcim.5c02645">Read paper <span class="arrow">→</span></a>
        </article>
      </div>
      <div class="btn-row">
        <a class="link-arrow" href="/publications">All publications <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="section section--cta">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Contact</p>
        <h2>Want to get involved?</h2>
        <p>
          Whether you're thinking about joining, looking to
          collaborate, or just want to exchange ideas — we'd be glad to hear
          from you.
        </p>
      </div>
      <a class="btn btn-primary" href="/contact">Get in touch <span class="arrow">→</span></a>
    </div>
  </section>
  <script>
    // Crossfading slideshow. Drives every .slideshow on the page.
    const DELAY = 5000;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('.slideshow').forEach((root) => {
      const slides = Array.from(root.querySelectorAll<HTMLImageElement>('.slideshow-track img'));
      const dotsBox = root.querySelector('.slideshow-dots')!;
      if (slides.length < 2) return;

      let index = 0;
      let timer: ReturnType<typeof setInterval> | undefined;
      let inView = false;

      const show = (next: number) => {
        index = (next + slides.length) % slides.length;
        slides.forEach((img, i) => img.classList.toggle('is-active', i === index));
        dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
      };

      const restart = () => {
        clearInterval(timer);
        if (!still && inView) timer = setInterval(() => show(index + 1), DELAY);
      };

      const dots = slides.map((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('aria-label', `Show photo ${i + 1} of ${slides.length}`);
        dot.addEventListener('click', () => { show(i); restart(); });
        dotsBox.appendChild(dot);
        return dot;
      });

      root.querySelector('.slideshow-arrow--prev')!.addEventListener('click', () => { show(index - 1); restart(); });
      root.querySelector('.slideshow-arrow--next')!.addEventListener('click', () => { show(index + 1); restart(); });

      // Don't advance under the cursor or while the tab is hidden.
      root.addEventListener('mouseenter', () => clearInterval(timer));
      root.addEventListener('mouseleave', restart);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) clearInterval(timer);
        else restart();
      });

      // Only auto-advance while the slideshow is scrolled into view.
      new IntersectionObserver((entries) => {
        inView = entries[0].isIntersecting;
        if (inView) restart();
        else clearInterval(timer);
      }, { threshold: 0.35 }).observe(root);

      show(0);
      restart();
    });
  </script>
</Layout>
