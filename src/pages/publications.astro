---
import Layout from '../layouts/Layout.astro';
import PubList from '../components/PubList.astro';
import { publications } from '../data/publications';

// Every year is an expandable section. Years after this one start open;
// this year and older start collapsed. Change it to move the cut-off.
const COLLAPSE_FROM = 2021;
---
<Layout title="Heid Lab — Publications" active="publications" scripts={["header.js"]}>
  <main>
    <h1>Publications</h1>
    <p>A complete list of work from the lab.</p>

    <div class="pubs-folds">
      {publications.map((group) => (
        <details class="pubs-fold" open={Number(group.year) > COLLAPSE_FROM}>
          <summary>
            <h2>{group.year}</h2>
            <span class="chev" aria-hidden="true">▾</span>
          </summary>
          <PubList items={group.items} />
        </details>
      ))}
    </div>
  </main>
</Layout>
