---
import Layout from '../layouts/Layout.astro';
import IconSprite from '../components/IconSprite.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Heid Lab — Esther Heid" active="team" scripts={["header.js"]}>
  <IconSprite slot="pre-header" />

  <!-- Intro — portrait carries the top of the page instead of a hero image.
       Built on the roster-lead layout (as on the About Us page) so the photo
       stretches to match the bio height rather than leaving a gap beneath it. -->
  <section class="section section--alt">
    <div class="wrap wrap--anchor">
      <a class="back-link" href={`${base}/team#esther-heid`}>
        <span class="arrow">←</span> Go back
      </a>
      <ul class="roster roster--lead">
        <li>
          <div class="person-photo">
            <img src={`${base}/imgs/team_members/esther-heid.jpg`} alt="Esther Heid" />
            <p class="photo-credit">Photo: © Ulrich Zinell</p>
          </div>
          <div class="person-body">
            <p class="eyebrow">Principal Investigator</p>
            <h3>Esther Heid</h3>
            <p class="person-role">Assistant Professor · Machine Learning for Sustainable Chemistry · TU Wien</p>
            <p class="pi-badges">
              <a class="pi-badge" href="#awards">🏆 ERC Starting Grant · 2024</a>
              <a class="pi-badge" href="#awards">🏆 FWF START Prize · 2024</a>
            </p>
            <p>
              Esther Heid is an Assistant Professor for Machine Learning for
              Sustainable Chemistry in the Faculty of Technical Chemistry, TU Wien,
              Austria, and head of the TU-wide dataTUdiscovery AI/ML service center.
              She received her Ph.D. in Theoretical Chemistry from the University of
              Vienna in 2019. She subsequently held postdoctoral positions at MIT
              (2020–2022) and TU Wien (2022–2024), where she advanced her work at the
              interface of chemistry and machine learning. In 2024, she was awarded a
              prestigious ERC Starting Grant along with an FWF START Prize, and started
              her own research group at TU Wien.
            </p>
            <p>
              As a scientist, teacher, and mentor, Esther Heid works at the interface of
              machine learning and chemistry, using computers to simulate, predict, and
              optimize chemical processes. Her current research focuses on
              machine-learned reaction property prediction, drawing on graph theory,
              cheminformatics, and deep learning to better understand chemical reactions
              and, in the longer term, to develop computational approaches for the
              eco-friendly synthesis of a wide range of target molecules.
            </p>
            <p>
              She also develops and maintains scientific software, including a Python
              package that predicts molecule and reaction properties with
              graph-convolutional neural networks. Her further expertise spans the
              simulation of soft matter and the quantum-mechanical calculation of
              molecular and atomic properties.
            </p>
            <div class="person-foot">
              <p class="person-links">
                <a class="mail" href="mailto:esther.heid@tuwien.ac.at">esther.heid@tuwien.ac.at</a>
                <a href="https://github.com/hesther"><svg class="icon" role="img" aria-label="GitHub"><use href="#i-github"></use></svg></a>
                <a href="https://www.linkedin.com/in/esther-heid-ab20001a6/"><svg class="icon" role="img" aria-label="LinkedIn"><use href="#i-linkedin"></use></svg></a>
                <a href="https://scholar.google.com/citations?user=NDE5issAAAAJ&hl=en"><svg class="icon" role="img" aria-label="Google Scholar"><use href="#i-scholar"></use></svg></a>
                <!-- TODO: add the TU Wien staff profile URL. -->
              </p>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Career & education -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Curriculum Vitae</p>
        <h2>Career &amp; education</h2>
      </div>
      <ol class="cv">
        <li>
          <div class="cv-when">Since Dec 2024</div>
          <div class="cv-what">
            <h3>Assistant Professor</h3>
            <p class="cv-where">TU Wien, Austria</p>
            <p>Machine Learning for Sustainable Chemistry.</p>
          </div>
        </li>
        <li>
          <div class="cv-when">Jan 2022 – Nov 2024</div>
          <div class="cv-what">
            <h3>Postdoctoral Fellow</h3>
            <p class="cv-where">TU Wien, Austria</p>
            <p>“Computer-aided design of multi-enzyme cascades”, with Prof. Georg Madsen.</p>
          </div>
        </li>
        <li>
          <div class="cv-when">Jan 2020 – Jan 2022</div>
          <div class="cv-what">
            <h3>Postdoctoral Fellow</h3>
            <p class="cv-where">Massachusetts Institute of Technology, USA</p>
            <p>“Computer-aided design of multi-enzyme cascades”, with Prof. William H. Green.</p>
          </div>
        </li>
        <li>
          <div class="cv-when">Oct 2016 – Dec 2019</div>
          <div class="cv-what">
            <h3>Doctoral Program, Natural Sciences: Chemistry</h3>
            <p class="cv-where">University of Vienna, Austria — Supervisor: Prof. Christian Schröder</p>
            <p>Thesis: “Concepts of solvation dynamics in molecular dynamics simulation”.</p>
          </div>
        </li>
        <li>
          <div class="cv-when">Aug – Sep 2018</div>
          <div class="cv-what">
            <h3>Visiting Scientist</h3>
            <p class="cv-where">University of Maryland, Baltimore, USA</p>
            <p>“Prediction of atomic polarizabilities”, with Prof. Alexander MacKerell.</p>
          </div>
        </li>
        <li>
          <div class="cv-when">Jan – Feb 2017</div>
          <div class="cv-what">
            <h3>Visiting Scientist</h3>
            <p class="cv-where">Imperial College London, UK</p>
            <p>“Atomic polarizabilities of chromophores”, with Prof. Patricia Hunt.</p>
          </div>
        </li>
        <li>
          <div class="cv-when">Oct 2014 – Sep 2016</div>
          <div class="cv-what">
            <h3>Master of Science, Chemistry</h3>
            <p class="cv-where">University of Vienna, Austria — Supervisor: Prof. Christian Schröder</p>
            <p>Thesis: “Computational solvation dynamics of oxyquinoline linked to trehalose”.</p>
          </div>
        </li>
        <li>
          <div class="cv-when">Mar 2011 – Jul 2014</div>
          <div class="cv-what">
            <h3>Bachelor of Science, Chemistry</h3>
            <p class="cv-where">University of Vienna, Austria — Supervisor: Prof. Christian Schröder</p>
            <p>Thesis: “Inter- and intramolecular vibrations in ionic liquids”.</p>
          </div>
        </li>
        <li>
          <div class="cv-when">Sep – Dec 2010</div>
          <div class="cv-what">
            <h3>Stay Abroad</h3>
            <p class="cv-where">England and Wales, UK</p>
            <p>Volunteer work in the social sector.</p>
          </div>
        </li>
        <li>
          <div class="cv-when">Jun 2010</div>
          <div class="cv-what">
            <h3>School Leaving Examination</h3>
            <p class="cv-where">BG/BRG Keimgasse, Mödling, Austria</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Awards -->
  <section class="section section--alt" id="awards">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Recognition</p>
        <h2>Awards &amp; fellowships</h2>
      </div>
      <div class="awards">
        <div class="award-year">
          <div class="ay-num">2024</div>
          <ul>
            <li><strong>ERC Starting Grant</strong> — “Deep learning of chemical reactions”</li>
            <li><strong>START Prize</strong> — Austrian Science Fund (FWF)</li>
          </ul>
        </div>
        <div class="award-year">
          <div class="ay-num">2022</div>
          <ul>
            <li><strong>Poster Award</strong> — Austrian Marshall Plan Foundation</li>
          </ul>
        </div>
        <div class="award-year">
          <div class="ay-num">2020</div>
          <ul>
            <li><strong>Award of Excellence</strong> — Federal Ministry of the Republic of Austria, given annually for the 40 best dissertations in all fields</li>
            <li><strong>Loschmidt Award</strong> — Chemical-Physical Society of Vienna, for an excellent doctoral thesis in chemistry and physics</li>
            <li><strong>Karl Schlögl Award</strong> — Austrian Academy of Sciences, given annually to two awardees for an outstanding doctoral thesis in chemistry</li>
            <li><strong>Rising Star in Chemical Engineering</strong> — named by MIT</li>
          </ul>
        </div>
        <div class="award-year">
          <div class="ay-num">2019</div>
          <ul>
            <li><strong>Schrödinger Fellowship</strong> — Austrian Science Fund, for postdoctoral studies</li>
          </ul>
        </div>
        <div class="award-year">
          <div class="ay-num">2018</div>
          <ul>
            <li><strong>Best oral presentation</strong> — 2nd “Advances in Green Chemistry” conference</li>
            <li><strong>NaturTalente</strong> — selected for the high-potential program, University of Vienna</li>
          </ul>
        </div>
        <div class="award-year">
          <div class="ay-num">2017</div>
          <ul>
            <li><strong>DOC fellowship</strong> — Austrian Academy of Sciences, for Ph.D. studies</li>
            <li><strong>Best poster award</strong> — 7th Visegrád Symposium on Structural Systems Biology</li>
          </ul>
        </div>
        <div class="award-year">
          <div class="ay-num">2014</div>
          <ul>
            <li><strong>Excellence scholarship (M.Sc.)</strong> — University of Vienna, two consecutive years (2014–2016)</li>
          </ul>
        </div>
        <div class="award-year">
          <div class="ay-num">2011</div>
          <ul>
            <li><strong>Excellence scholarship (B.Sc.)</strong> — University of Vienna, three consecutive years (2011–2014)</li>
          </ul>
        </div>
        <div class="award-year">
          <div class="ay-num">2010</div>
          <ul>
            <li><strong>Ring of Honor</strong> — BG/BRG Keimgasse, for outstanding grades at school</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills & service -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Beyond the research</p>
        <h2>Skills &amp; service</h2>
      </div>
      <div class="skills">
        <div class="skill">
          <h3>Languages</h3>
          <p>German (native) · English (excellent, TOEFL 119/120)</p>
        </div>
        <div class="skill">
          <h3>Programming</h3>
          <div class="tags">
            <span class="tag">Python</span><span class="tag">Cython</span><span class="tag">Fortran</span><span class="tag">Bash</span><span class="tag">Unix</span><span class="tag">HPC</span>
          </div>
        </div>
        <div class="skill">
          <h3>Machine learning</h3>
          <div class="tags">
            <span class="tag">PyTorch</span><span class="tag">TensorFlow</span><span class="tag">Keras</span><span class="tag">scikit-learn</span>
          </div>
        </div>
        <div class="skill">
          <h3>Chemistry &amp; simulation</h3>
          <div class="tags">
            <span class="tag">Gaussian09</span><span class="tag">Psi4</span><span class="tag">CHARMM</span><span class="tag">MDAnalysis</span><span class="tag">LaTeX</span><span class="tag">Gnuplot</span>
          </div>
        </div>
        <div class="skill">
          <h3>Outreach</h3>
          <p>
            Young Investigators Academy, TU Wien · WoChem (Women in Chemistry),
            University of Vienna · board member of POWER, a network for female
            postdocs at MIT
          </p>
        </div>
        <div class="skill">
          <h3>Societies</h3>
          <p>Chemisch-Physikalische Gesellschaft (CPG)</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="section section--cta section--alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Publications</p>
        <h2>See the full publication list</h2>
        <p>
          Papers, preprints, and software from the group — or get in touch about
          collaborating.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href={`${base}/publications`}>Publications <span class="arrow">→</span></a>
        <a class="btn btn-outline" href={`${base}/contact`}>Get in touch <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <script is:inline>
    // Copy the third-person short bio to the clipboard.
    document.querySelector('[data-copy-bio]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const text = document.getElementById('short-bio')?.textContent.trim();
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const r = document.createRange(); const sel = getSelection();
        const el = document.getElementById('short-bio');
        el.hidden = false; r.selectNodeContents(el); sel.removeAllRanges(); sel.addRange(r);
        document.execCommand('copy'); sel.removeAllRanges(); el.hidden = true;
      }
      const label = btn.querySelector('.arrow');
      const orig = btn.firstChild.textContent;
      btn.firstChild.textContent = 'Copied ';
      if (label) label.textContent = '✓';
      setTimeout(() => { btn.firstChild.textContent = orig; if (label) label.textContent = '⧉'; }, 1600);
    });
  </script>
</Layout>
