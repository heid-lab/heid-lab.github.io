---
import Layout from '../layouts/Layout.astro';
import PubList from '../components/PubList.astro';
import GrantPeople from '../components/GrantPeople.astro';
import { pi } from '../data/team';
import { pubsByFunding } from '../data/publications';

// Publications acknowledging the ERC grant, grouped by year — tagged
// funding: ['erc'] in publications.ts, so this list stays in sync when papers
// are added there.
const relatedPubs = pubsByFunding('erc');

// CORDIS subject/keyword tags for the project (cordis.europa.eu/project/id/101162908).
const keywords = [
  'Machine learning',
  'Deep learning',
  'Reaction properties',
  'Enzymatic cascade design',
  'Asymmetric organocatalysis',
];

// Headline figures for the stat strip.
const stats = [
  { num: '€1.5M', label: 'ERC funding' },
  { num: '5 yrs', label: '2024–2029' },
  { num: '2024', label: 'Starting Grant awarded' },
];

// The three research strands, each drawn as a card.
const goals = [
  {
    tag: 'Reaction energetics',
    title: 'Activation energies',
    body: 'Predicting barrier heights and transition state geometries fast enough for high-throughput screening.',
  },
  {
    tag: 'Biocatalysis',
    title: 'Enzymatic pathways',
    body: 'Exploring biocatalytic routes and supporting the data-driven design of enzymatic cascades.',
  },
  {
    tag: 'Asymmetric organocatalysis',
    title: 'Modeling stereoselectivity',
    body: 'Predicting enantio- and diastereoselectivity for asymmetric organocatalytic reactions.',
  },
];

// Official project facts (from the CORDIS record).
const facts = [
  { label: 'Project', value: 'DeepRxn — Deep learning of chemical reactions' },
  { label: 'Funder', value: 'European Research Council (ERC)' },
  { label: 'Scheme', value: 'ERC Starting Grant · Horizon Europe (ERC-2024-STG)' },
  { label: 'Grant agreement', value: 'No. 101162908' },
  { label: 'Duration', value: 'October 2024 – September 2029' },
  { label: 'EU contribution', value: '€1,499,285' },
  { label: 'Host institution', value: 'TU Wien — Institute of Materials Chemistry' },
];

// People currently working on the ERC project. Names link to the person's card
// on the team page and photos come from team.ts (see GrantPeople.astro).
const people = [
  { name: pi.name, note: 'Principal investigator', href: '/pi' },
  { name: 'Jonathan Zheng', note: 'Postdoc · enzymatic reactions' },
  { name: 'Jasper De Landsheere', note: 'Ph.D. · reaction property prediction' },
  { name: 'Leon Ganser', note: 'Ph.D. · asymmetric organocatalysis' },
];

// Former contributors to the project.
const pastPeople = [
  { name: 'Johannes Karwounopoulos', note: 'Postdoc (2025–2026)' },
  { name: 'Charlotte Gerhaher', note: 'Ph.D. (2025–2026)' },
  { name: 'Konstantin Mark', note: 'Ph.D. (2025–2026)' },
  { name: 'Maximilian P.-P. Kovar', note: 'Ph.D. (2026)' },
];
---
<Layout
  title="Heid Lab — ERC Starting Grant (DeepRxn)"
  description="DeepRxn, an ERC Starting Grant project at TU Wien (2024–2029), develops deep learning frameworks that predict how organic and enzymatic reactions proceed."
>
  <div class="page grant-page">
    <section class="grant-hero">
      <div class="grant-hero-inner">
        <div class="grant-hero-text">
          <p class="eyebrow">European Research Council · Starting Grant · 2024–2029</p>
          <h1>DeepRxn — Deep learning of chemical reactions</h1>
          <p class="grant-lead">
            <strong>DeepRxn</strong> is a research project funded by an ERC Starting Grant,
            awarded to Asst. Prof. Esther Heid in 2024. It develops new, data-driven deep-learning
            frameworks that predict how organic and enzymatic reactions proceed — their
            products, rates, and, above all, their chemo-, regio-, and stereoselectivity.
          </p>
        </div>
        <div class="grant-hero-logos">
          <span class="grant-hero-logo">
            <img src="/imgs/grants/deeprxn-logo.png" alt="DeepRxn — Deep learning of chemical reactions" />
          </span>
          <span class="grant-hero-logo grant-hero-logo--erc">
            <img src="/imgs/grants/erc-eu-logo.png" alt="Funded by the European Union — European Research Council" />
          </span>
        </div>
        <div class="tags grant-tags">
          {keywords.map((k) => <span class="tag">{k}</span>)}
        </div>
      </div>
    </section>

    <ul class="grant-stats">
      {stats.map((s) => (
        <li>
          <span class="grant-stat-num">{s.num}</span>
          <span class="grant-stat-label">{s.label}</span>
        </li>
      ))}
    </ul>

    <div class="grant-row">
      <h2 class="grant-row-head">The challenge</h2>
      <p class="grant-row-body">
        Exploring reactions is a central topic in chemistry, yet compared to the success of
        machine learning for molecules, the modeling of reactions is lagging behind —
        especially for stereo- and regioselective reactions. Current efforts toward sustainable
        synthesis, such as asymmetric organocatalysis and biocatalysis, rely on accurately
        predicting enantio- and regioselective reaction pathways. Meeting that need calls for
        new modeling approaches that go beyond the two-dimensional representations, reaction
        rules, and fixed three-dimensional inputs that today's methods depend on.
      </p>
    </div>

    <div class="grant-row">
      <h2 class="grant-row-head">Our approach</h2>
      <p class="grant-row-body">
        DeepRxn develops new, data-driven deep-learning frameworks for modeling organic and
        enzymatic reactions, focusing on the chemo-, regio-, and stereoselectivity that arises
        through intermolecular interactions with the reagent, solvent, or catalyst. We extend
        molecular graph-convolutional neural networks and graph transformers to reactions in a
        rule-free manner, and introduce hidden three-dimensional representations that capture
        stereochemistry and account for atom mapping on the fly. The result is a versatile,
        open-source toolbox for reaction deep learning.
      </p>
    </div>

    <p class="grant-goals-lead">The DeepRxn project tackles three key areas:</p>
    <ul class="grant-goals">
      {goals.map((g) => (
        <li>
          <span class="pub-year">{g.tag}</span>
          <strong>{g.title}</strong>
          <p>{g.body}</p>
        </li>
      ))}
    </ul>

    <h2>Official project information</h2>
    <div class="fact-box">
      <dl class="fact-list">
        {facts.map((f) => (
          <div class="fact-row">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
      <a class="link-arrow" href="https://cordis.europa.eu/project/id/101162908/en" target="_blank" rel="noopener">
        View on CORDIS <span class="arrow">→</span>
      </a>
    </div>

    <h2>People on the project</h2>
    <GrantPeople people={people} />
    <h3 class="grant-people-past-head">Past contributors</h3>
    <GrantPeople people={pastPeople} past />

    <h2>Work supported by the ERC</h2>
    <p>Publications funded by this grant. Our full list is on the <a href="/publications">Publications</a> page.</p>
    {relatedPubs.map((group) => (
      <Fragment>
        <h3 class="grant-pubs-year">{group.year}</h3>
        <PubList items={group.items} />
      </Fragment>
    ))}

    <h2>Acknowledgment</h2>
    <p class="grant-ack">
      Funded by the European Union (ERC-2024-STG, Project 101162908—DeepRxn). Views and
      opinions expressed are however those of the author(s) only and do not necessarily reflect
      those of the European Union or the European Research Council. Neither the European Union
      nor the granting authority can be held responsible for them.
    </p>
  </div>
</Layout>
