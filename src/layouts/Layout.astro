---
// The shared page skeleton: <head>, header, footer, and the global stylesheet.
// Every page wraps its content in this.
//
// Props:
//   title       -> <title> text
//   description -> one-sentence summary of the page, shown by search engines
//                  under the title and in link previews (Slack, LinkedIn, …)
//   active      -> nav key to highlight (see Header.astro)
//   noJs        -> set <html class="no-js"> (team page progressive enhancement)
//
// Scripts live in a <script> tag in the component or page whose markup they
// drive; Astro bundles them and loads each one only on pages that use it.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IconSprite from '../components/IconSprite.astro';
import '../styles/style.css';

interface Props {
  title: string;
  description?: string;
  active?: string;
  noJs?: boolean;
}
const {
  title,
  description = 'The Heid Lab at TU Wien develops machine learning methods for chemical reactions.',
  active,
  noJs = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class={noJs ? 'no-js' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Tab icon: SVG for modern browsers, .ico fallback. sizes="32x32" keeps
         Chrome from preferring the .ico over the SVG. -->
    <link rel="icon" href="/imgs/favicon/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/imgs/favicon/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <IconSprite />
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
