---
// Site header + primary navigation. Rendered on every page via Layout.
// Pass the current page's key so its nav link gets the "active" style.
// To change the nav, edit this file only.
interface Props {
  active?: string;
}
const { active } = Astro.props;

const links = [
  { key: 'home', label: 'Home', href: '/' },
  { key: 'team', label: 'About us', href: '/team' },
  { key: 'news', label: 'News', href: '/news' },
  { key: 'research', label: 'Research', href: '/research' },
  { key: 'publications', label: 'Publications', href: '/publications' },
  { key: 'teaching', label: 'Teaching', href: '/teaching' },
  { key: 'contact', label: 'Contact', href: '/contact', cta: true },
];
---
<header class="site-header">
  <div class="nav-wrap">
    <a class="brand" href="/">Heid <span>Lab</span></a>
    <nav class="main-nav">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[{ active: active === l.key }, { 'nav-cta': l.cta }]}
        >{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  // Condenses the sticky header once the page is scrolled.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const THRESHOLD = 40;
    let ticking = false;

    const update = () => {
      header.classList.toggle('is-scrolled', window.scrollY > THRESHOLD);
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });

    update();
  }
</script>
