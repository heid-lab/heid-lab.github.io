---
import type { Member } from '../data/team';
import { initials, slug } from '../data/team';
import SocialLinks from './SocialLinks.astro';

interface Props {
  member: Member;
}
const { member } = Astro.props;

const avatarClass = ['team-card-avatar', member.avatar && `team-card-avatar--${member.avatar}`]
  .filter(Boolean)
  .join(' ');
---
<li id={slug(member.name)} class:list={['team-card', { 'team-card--colbreak': member.colbreak }]}>
  <div class="team-card-head">
    <div class={avatarClass}>
      {member.photo ? (
        <img src={`/imgs/team_members/${member.photo}`} alt={member.name} />
      ) : (
        <>
          {member.photoTodo && <Fragment set:html={`<!-- TODO: ${member.photoTodo} -->`} />}
          <div class="initials" aria-hidden="true">{initials(member.name)}</div>
        </>
      )}
    </div>
    <div>
      <h3>{member.name}</h3>
      <p class="team-card-role">{member.role}</p>
    </div>
  </div>
  <div class="team-card-bio">
    {(member.bio ?? []).map((para) => <p set:html={para} />)}
    {(!member.bio || member.bio.length === 0) && <p><!-- TODO: project topic. --></p>}
  </div>
  <SocialLinks links={member.links} />
</li>
