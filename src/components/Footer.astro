---
// Site footer. Rendered on every page via Layout.

// The year the site was built, so the copyright line stays current with each
// deploy.
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <!-- TU LOGO — footer -->
    <span class="footer-brand">
      <img class="tu-logo" src="/imgs/TU-signet/TU_Signet_RGB.svg" alt="TU Wien" />
      Heid Lab · <a href="https://www.tuwien.at/en" target="_blank" rel="noopener">TU Wien</a> · <a href="https://www.tuwien.at/en/tch/imc" target="_blank" rel="noopener">Institute of Materials Chemistry</a>
    </span>
    <span class="footer-end">
      <a class="footer-github" href="https://github.com/heid-lab" target="_blank" rel="noopener" aria-label="Heid Lab on GitHub">
        <svg class="gh-icon" aria-hidden="true" width="16" height="16" fill="currentColor"><use href="#i-github"></use></svg>
        GitHub
      </a>
      <span>© {year} Heid Lab · All rights reserved</span>
    </span>
  </div>
</footer>
